# Chiave API del gateway SMS (Textbelt).
#
# Se lasciata vuota l'app usa la chiave pubblica gratuita "textbelt",
# che concede 1 SMS al giorno per indirizzo IP del server.
#
# Con una chiave personale (https://textbelt.com) gli invii sono illimitati
# fino ai crediti acquistati: nessun'altra modifica al codice e' necessaria.
TEXTBELT_KEY=

# Solo per sviluppo/test: sostituisce l'endpoint del gateway con un altro
# (per esempio un server simulato locale). In produzione va lasciata vuota.
# TEXTBELT_API_BASE=http://127.0.0.1:4555
